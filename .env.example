# CALENDAIR — never commit real secrets.

# hybrid = deterministic calendar + real Atlas where authorised
# visual = deterministic everything, for UI rehearsal only
DEMO_MODE=hybrid
DEMO_SCENARIO=perfect
MAX_REPLANS=2

# ATLAS_INTEGRATION_MODE selects the adapter in src/lib/atlas/index.ts:
#   (unset)  DemoAtlasAdapter — deterministic search, verify, booking, status.
#   skill    SkillAtlasAdapter — live atlas-flight CLI for every call. Search
#            works today; verifyOffer (and everything after it) fails with
#            SUBSCRIPTION_REQUIRED until this account's ticketing activation
#            completes at https://www.atriptech.com/#/workspace.
#   hybrid   HybridAtlasAdapter — live atlas-flight CLI for search, deterministic
#            demo adapter for verify/booking/status. Lets a demo run against
#            real inventory without depending on ticketing activation. Every
#            capability's real provenance (search vs ticketing, live vs demo)
#            is reported by /api/health and by AtlasAdapter.getStatus() — see
#            src/lib/atlas/hybrid-adapter.ts for the full rationale. (This is
#            unrelated to DEMO_MODE's "hybrid" value above, which is about the
#            calendar side, not Atlas — the two happen to share a name.)
#   atrip    UnwiredAtlasAdapter placeholder — not implemented; fails loudly
#            rather than substituting demo data for a live call.
# Set ATLAS_CLI_PATH to the atlas-flight binary when it is not on the server PATH
# (uv installs to ~/.local/bin; this is auto-detected, but explicit is safer).
ATLAS_ENV=sandbox
ATLAS_INTEGRATION_MODE=
ATLAS_CLI_PATH=

# NOT read anywhere in src/lib/atlas. atlas-flight manages its own auth on the
# host (`atlas-flight auth login`, once) — skill-adapter.ts and hybrid-adapter.ts
# never touch these four. Kept only so a stale .env.local doesn't look
# mysterious; safe to delete. /api/health does not derive anything from them.
ATLAS_BASE_URL=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Alibaba Cloud Model Studio (Qwen) — language only, never pricing or booking.
# With these set, the escape screen gains a Qwen-authored "why this fits" line;
# without them it shows the deterministic reasons and nothing breaks.
ALIBABA_CLOUD_MODEL_STUDIO_API_KEY=
QWEN_MODEL=
# Defaults to the DashScope international compatible-mode endpoint.
QWEN_BASE_URL=
