[
 {
  "text": "Here's what nobody tells you.",
  "start": 0.0,
  "end": 1.6533333333333333
 },
 {
  "text": "The broke version of you...",
  "start": 2.1033333333333335,
  "end": 3.5885000000000002
 },
 {
  "text": "is the only version that isn't scared to lose.",
  "start": 3.7085000000000004,
  "end": 6.381083333333334
 },
 {
  "text": "The second you have something,",
  "start": 6.701083333333333,
  "end": 8.175208333333334
 },
 {
  "text": "you start protecting it.",
  "start": 8.295208333333333,
  "end": 9.593416666666666
 },
 {
  "text": "You stop taking shots.",
  "start": 9.913416666666667,
  "end": 11.43575
 },
 {
  "text": "So take them now.",
  "start": 11.755749999999999,
  "end": 12.9055
 },
 {
  "text": "While losing costs you nothing.",
  "start": 13.225499999999998,
  "end": 14.840541666666665
 },
 {
  "text": "Because one day, losing a single day",
  "start": 15.160541666666665,
  "end": 17.399375
 },
 {
  "text": "will cost you a million.",
  "start": 17.719375,
  "end": 19.11975
 },
 {
  "text": "And you'd better already know",
  "start": 19.43975,
  "end": 20.96216666666667
 },
 {
  "text": "how to get back up.",
  "start": 21.28216666666667,
  "end": 22.434833333333337
 }
]